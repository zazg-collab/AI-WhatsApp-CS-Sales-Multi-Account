{
  "name": "@sentinel/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "kb:reindex": "nest build && node dist/scripts/reindex-knowledge.js",
    "lint": "eslint src",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:int": "jest --config ./test/jest-int.json --runInBand"
  },
  "jest": {
    "rootDir": ".",
    "roots": [
      "<rootDir>/src"
    ],
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/tsconfig.json"
        }
      ]
    },
    "moduleNameMapper": {
      "^@sentinel/database$": "<rootDir>/../../packages/database/src/index.ts",
      "^@whiskeysockets/baileys$": "<rootDir>/test/baileys.mock.ts"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s",
      "!src/**/*.module.ts",
      "!src/main.ts",
      "!src/**/*.dto.ts",
      "!src/**/dto/**"
    ],
    "coverageDirectory": "<rootDir>/coverage",
    "testEnvironment": "node",
    "maxWorkers": "50%",
    "testTimeout": 15000
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1065.0",
    "@sentinel/database": "*",
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/platform-socket.io": "^10.4.0",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/websockets": "^10.4.0",
    "@prisma/client": "^5.22.0",
    "@whiskeysockets/baileys": "7.0.0-rc13",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.78.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "exceljs": "^4.4.0",
    "mammoth": "^1.12.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-parse": "^1.1.4",
    "pg": "^8.21.0",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "0.1.14",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.2",
    "socket.io": "^4.8.0",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.7.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^7.2.1",
    "jest": "^30.4.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "5.6.3"
  }
}

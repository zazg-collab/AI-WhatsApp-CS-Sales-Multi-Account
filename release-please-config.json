{
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "sentinel-control-center",
      "versioning": "independent",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false,
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true
    }
  },
  "plugins": [
    "conventional-commits",
    "changelog",
    "github"
  ],
  "rules": {
    "major": ["breaking"],
    "minor": ["feat"],
    "patch": ["fix", "perf", "refactor", "docs", "chore", "test", "build", "ci"]
  },
  "additional-branches": ["main", "master"]
}
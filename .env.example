# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001/events

# ── API / Security ─────────────────────────────────────────────────────────
# REQUIRED: the API and Socket.IO gateway refuse to start without this.
# Generate with: openssl rand -base64 48
JWT_SECRET=change-this-before-deploying
JWT_EXPIRES_IN=7d

# CORS allowlist (comma-separated origins). The API never reflects arbitrary
# origins while sending credentials. Set this to your web origin(s).
CORS_ORIGINS=http://localhost:3000

# In-memory limiter defaults. For multi-instance production deployments, put a
# Redis/API-gateway limiter in front or replace the app limiter with a shared one.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_PER_IP=300
RATE_LIMIT_PER_USER=600

# ── Database / Queue ───────────────────────────────────────────────────────
# Prisma pool tuning is included in the URL. Adjust connection_limit/pool_timeout
# based on the database plan and API replica count.
DATABASE_URL=postgresql://hermes:hermes@localhost:5432/hermes?schema=public&connection_limit=10&pool_timeout=20
REDIS_URL=redis://localhost:6379

# ── Web ────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL is defined above for both local and deployed web builds.

# ── AI Provider (OpenAI-compatible) ────────────────────────────────────────
# Works with any OpenAI-compatible endpoint. Examples:
#   Nous Portal  https://inference-api.nousresearch.com/v1   (Hermes models)
#   Nous proxy   http://127.0.0.1:8645/v1                     (local subscription proxy)
#   OpenRouter   https://openrouter.ai/api/v1
#   OpenAI       https://api.openai.com/v1
#   Ollama       http://localhost:11434/v1
#   LM Studio    http://localhost:1234/v1
#   vLLM         http://localhost:8000/v1
# The app lists available models from {AI_BASE_URL}/models.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Recommended Hermes model via Nous Portal:
# AI_BASE_URL=https://inference-api.nousresearch.com/v1
# AI_MODEL=Hermes-4-70B

# ── WhatsApp Gateway (Baileys) ─────────────────────────────────────────────
# Must be persistent storage in production; losing it forces QR re-login.
WA_SESSION_DIR=.wa-sessions

# ── Notifications (via Hermes Agent gateway) ───────────────────────────────
# Outbound alerts are delivered through the Hermes Agent CLI:
#   hermes send --to <target>
# Configure platform credentials inside Hermes Agent (`hermes gateway setup`).
# Leave HERMES_NOTIFY_TARGET empty/commented to disable outbound alerts.
# HERMES_NOTIFY_TARGET=telegram
HERMES_BIN=hermes

# ── Hermes Agent sidecar (optional, agentic supervision) ───────────────────
# Python sidecar wrapping hermes-agent's AIAgent (services/hermes-sidecar).
# HERMES_SIDECAR_URL=http://localhost:8675
# HERMES_AGENT_MODEL=Hermes-4-70B
# HERMES_AGENT_MEMORY=true

# ── Seed (initial owner account) ───────────────────────────────────────────
SEED_OWNER_EMAIL=owner@hermes.local
SEED_OWNER_PASSWORD=changeme123

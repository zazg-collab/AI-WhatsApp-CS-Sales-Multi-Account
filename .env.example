# ── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://hermes:hermes@localhost:5432/hermes?schema=public"
REDIS_URL="redis://localhost:6379"

# ── API ───────────────────────────────────────────────────
API_PORT=3001
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# ── Web ───────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"

# ── AI Provider (OpenAI-compatible) ───────────────────────
# Works with any OpenAI-compatible endpoint. Examples:
#   Nous Portal  https://inference-api.nousresearch.com/v1   (Hermes models)
#   Nous proxy   http://127.0.0.1:8645/v1                     (local subscription proxy)
#   OpenRouter   https://openrouter.ai/api/v1
#   OpenAI       https://api.openai.com/v1
#   Ollama       http://localhost:11434/v1
#   LM Studio    http://localhost:1234/v1
#   vLLM         http://localhost:8000/v1
# The app lists available models from {AI_BASE_URL}/models.
#
# Recommended: Nous Research Hermes models via Nous Portal.
# Model ids: Hermes-4-70B, Hermes-4.3-36B, Hermes-4-405B
AI_BASE_URL="https://inference-api.nousresearch.com/v1"
AI_API_KEY=""
AI_MODEL="Hermes-4-70B"

# ── WhatsApp Gateway (Baileys) ────────────────────────────
WA_SESSION_DIR="./.wa-sessions"

# ── Notifications (via Hermes Agent gateway) ──────────────
# Outbound alerts are delivered through the Hermes Agent CLI
# (NousResearch/hermes-agent): `hermes send --to <target>`.
# Configure the actual platform credentials inside Hermes Agent
# (`hermes gateway setup`), not here. Supported: telegram, discord,
# slack:#channel, whatsapp, signal, sms, matrix, ...
# Leave HERMES_NOTIFY_TARGET empty to disable outbound alerts.
HERMES_NOTIFY_TARGET=""
HERMES_BIN="hermes"

# ── Hermes Agent sidecar (optional, agentic supervision) ──
# Python sidecar wrapping hermes-agent's AIAgent (services/hermes-sidecar).
# When set, the Hermes supervisor "ask"/bot-insight run through Hermes Agent
# (its model + memory + skills); otherwise they use the plain AI engine.
HERMES_SIDECAR_URL=""

# ── Seed (initial owner account) ──────────────────────────
SEED_OWNER_EMAIL="owner@hermes.local"
SEED_OWNER_PASSWORD="changeme123"

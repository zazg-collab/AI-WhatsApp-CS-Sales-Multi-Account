# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001/events

# ── API / Security ─────────────────────────────────────────────────────────
# REQUIRED: the API and Socket.IO gateway refuse to start without this.
# Generate with: openssl rand -base64 48
JWT_SECRET=change-this-before-deploying
JWT_EXPIRES_IN=24h

# CORS allowlist (comma-separated origins). The API never reflects arbitrary
# origins while sending credentials. Set this to your web origin(s).
CORS_ORIGINS=http://localhost:3000

# In-memory limiter defaults. For multi-instance production deployments, put a
# Redis/API-gateway limiter in front or replace the app limiter with a shared one.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_PER_IP=300
RATE_LIMIT_PER_USER=600

# Login brute-force lockout (per IP + email). Tighter than the global limiter.
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCKOUT_WINDOW_MS=900000

# Upper bound on every outbound AI/sidecar HTTP call so a hung provider can't
# stall auto-reply indefinitely.
AI_TIMEOUT_MS=30000

# ── Database / Queue ───────────────────────────────────────────────────────
# Prisma pool tuning is included in the URL. Adjust connection_limit/pool_timeout
# based on the database plan and API replica count.
DATABASE_URL=postgresql://hermes:hermes@localhost:5432/hermes?schema=public&connection_limit=10&pool_timeout=20
REDIS_URL=redis://localhost:6379

# ── Web ────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL is defined above for both local and deployed web builds.

# ── AI Provider (OpenAI-compatible) ────────────────────────────────────────
# Works with any OpenAI-compatible endpoint. Examples:
#   Nous Portal  https://inference-api.nousresearch.com/v1   (Hermes models)
#   Nous proxy   http://127.0.0.1:8645/v1                     (local subscription proxy)
#   OpenRouter   https://openrouter.ai/api/v1
#   OpenAI       https://api.openai.com/v1
#   Ollama       http://localhost:11434/v1
#   LM Studio    http://localhost:1234/v1
#   vLLM         http://localhost:8000/v1
# The app lists available models from {AI_BASE_URL}/models.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Recommended Hermes model via Nous Portal:
# AI_BASE_URL=https://inference-api.nousresearch.com/v1
# AI_MODEL=Hermes-4-70B

# Hermes supervisor model (review/ask/insight). Empty = reuse AI_MODEL.
# Set a stronger model than the CS bot for better judgement.
# HERMES_MODEL=Hermes-4-405B

# ── Semantic knowledge retrieval / RAG (optional) ──────────────────────────
# When AI_EMBED_MODEL is set, knowledge items are embedded (via {AI_BASE_URL}
# /embeddings) and retrieved by meaning, not just keywords. Empty = keyword
# retrieval (no behaviour change). Requires the pgvector extension — applied by
# migration 20_knowledge_embeddings. After enabling on an existing DB, run
# `npm run kb:reindex` to backfill embeddings for existing items.
# AI_EMBED_MODEL=text-embedding-3-small
# AI_EMBED_DIM must match the vector(N) column in the migration (default 1536).
AI_EMBED_DIM=1536

# ── Campaign limits (WhatsApp ban mitigation, M8) ──────────────────────────
# Max recipients a single campaign may target.
CAMPAIGN_MAX_RECIPIENTS=1000
# Max campaign messages actually sent per WhatsApp account per 24h, across
# all campaigns. Keep this conservative — high outbound volume risks a ban.
CAMPAIGN_MAX_DAILY_SENDS=500

# ── SLA monitor (stale-chat alerts) ────────────────────────────────────────
# A chat whose last message is from the customer and has gone unanswered
# longer than this is flagged (badge in the UI + outbound notification).
SLA_RESPONSE_MINUTES=15
# How often the SLA scanner runs (milliseconds).
SLA_SCAN_INTERVAL_MS=60000

# ── Auto-assignment ────────────────────────────────────────────────────────
# How new (and unassigned) conversations are routed to admins:
#   off          — no auto-assignment (default; keep manual)
#   round_robin  — rotate through active admins
#   least_busy   — admin with the fewest open conversations
AUTO_ASSIGN_STRATEGY=off

# ── Auto-away (business hours) ─────────────────────────────────────────────
# Min gap between auto-away messages to the same customer (ms, default 12h).
# Business hours + the away message itself are configured per account in the UI.
AUTO_AWAY_COOLDOWN_MS=43200000

# ── CSAT (customer satisfaction) ───────────────────────────────────────────
# When a chat is resolved, ask the customer to rate 1–5; their next numeric
# reply within the window is captured as the score.
CSAT_ENABLED=false
CSAT_WINDOW_HOURS=24
# Optional override for the request message (a sensible Indonesian default is built in).
# CSAT_MESSAGE=

# ── WhatsApp Gateway (Baileys) ─────────────────────────────────────────────
# Must be persistent storage in production; losing it forces QR re-login.
WA_SESSION_DIR=.wa-sessions
# Keep true so chats/messages sent from the linked phone are mirrored into the dashboard.
# Set false only if first-link history backfill is too heavy for your account.
WA_SYNC_FULL_HISTORY=true

# Inbound media (images/documents/audio/video from customers) is downloaded
# and served at /api/v1/media/<file>.
# Max bytes per inbound media file; larger payloads are skipped (default 25MB).
WA_MEDIA_MAX_BYTES=26214400

# Media storage driver: "local" (default) or "s3".
#   local → files under WA_MEDIA_DIR (use persistent storage; single box only)
#   s3    → S3-compatible bucket, including Supabase Storage (multi-replica safe)
MEDIA_STORAGE_DRIVER=local
WA_MEDIA_DIR=.wa-media
# Required when MEDIA_STORAGE_DRIVER=s3:
# MEDIA_S3_BUCKET=hermes-media
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=
# MEDIA_S3_REGION=us-east-1
# For Supabase/MinIO set the S3 endpoint (enables path-style addressing):
# MEDIA_S3_ENDPOINT=https://<project>.supabase.co/storage/v1/s3
# Optional key prefix inside the bucket:
# MEDIA_S3_PREFIX=chat
# Serve straight from a public/CDN bucket instead of proxying through the API:
# MEDIA_S3_PUBLIC_BASE_URL=https://<project>.supabase.co/storage/v1/object/public/hermes-media

# ── WhatsApp Gateway (WAHA - replacement for Baileys) ────────────────────────
# WAHA (WhatsApp HTTP API) is a docker sidecar service that manages WhatsApp
# sessions via a REST API. It replaces Baileys for production deployments.
# Docker compose will run it on port 3002 (internally 3000).
# Leave empty or set to a strong random value for authentication.
# WAHA_API_KEY=

# ── Notifications (via Hermes Agent gateway) ───────────────────────────────
# Outbound alerts are delivered through the Hermes Agent CLI:
#   hermes send --to <target>
# Configure platform credentials inside Hermes Agent (`hermes gateway setup`).
# Leave HERMES_NOTIFY_TARGET empty/commented to disable outbound alerts.
# HERMES_NOTIFY_TARGET=telegram
HERMES_BIN=hermes

# ── Hermes Agent sidecar (optional, agentic supervision) ───────────────────
# Python sidecar wrapping hermes-agent's AIAgent (services/hermes-sidecar).
# Bind the sidecar to 127.0.0.1 and set a shared token — /ask is an agent
# endpoint and must never be exposed unauthenticated.
# HERMES_SIDECAR_URL=http://127.0.0.1:8675
# HERMES_SIDECAR_TOKEN=generate-with-openssl-rand-hex-32
# HERMES_AGENT_MODEL=Hermes-4-70B
# HERMES_AGENT_MEMORY=true

# ── Agent CRM report API (inbound, read-only supervisor) ───────────────────
# Lets the Hermes Agent gateway PULL read-only CRM reports from this app via
#   GET /api/v1/agent/crm-report   (header: x-api-key: <AGENT_API_KEY>)
# This is supervisor-scoped: read-only reports only — no mutations, no message
# sends, no user/settings access. Leave empty to disable the endpoint (it then
# returns 503). Generate with: openssl rand -hex 32
# AGENT_API_KEY=

# ── Observability / monitoring ─────────────────────────────────────────────
# Structured JSON logs are emitted by default. LOG_LEVEL sets the minimum level
# (verbose|debug|log|warn|error). LOG_PRETTY=true switches to human-readable
# colored output for local dev.
# LOG_LEVEL=log
# LOG_PRETTY=false
# Prometheus scrape endpoint is GET /api/v1/metrics. If METRICS_TOKEN is set the
# scraper must send it as a Bearer token; if unset, expose /metrics on an
# internal network only. Generate with: openssl rand -hex 32
# METRICS_TOKEN=
# Optional error webhook (Sentry-store / Slack incoming / any JSON sink). When
# set, server errors and unhandled rejections are POSTed here (no PII). Unset =
# log-only (structured error lines are always written regardless).
# ERROR_WEBHOOK_URL=
# Shared secret for POST /api/v1/internal/alerts (Alertmanager webhook
# receiver). Alertmanager sends it as `Authorization: Bearer <token>`; the
# endpoint forwards firing/resolved alerts through the existing
# HERMES_NOTIFY_TARGET channel. Leave empty to disable (returns 503).
# Generate with: openssl rand -hex 32
# ALERTMANAGER_WEBHOOK_TOKEN=

# ── Seed (initial owner account) ───────────────────────────────────────────
SEED_OWNER_EMAIL=owner@hermes.local
SEED_OWNER_PASSWORD=changeme123

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# Note: the Socket.IO URL is derived from NEXT_PUBLIC_API_URL automatically (suffix stripped).
# Setting this variable has no effect — keep NEXT_PUBLIC_API_URL correct instead.

# ── API / Security ─────────────────────────────────────────────────────────
# REQUIRED: the API and Socket.IO gateway refuse to start without this.
# Generate with: openssl rand -base64 48
JWT_SECRET=change-this-before-deploying
JWT_EXPIRES_IN=24h

# CORS allowlist (comma-separated origins). The API never reflects arbitrary
# origins while sending credentials. Set this to your web origin(s).
CORS_ORIGINS=http://localhost:3000

# In-memory limiter defaults. For multi-instance production deployments, put a
# Redis/API-gateway limiter in front or replace the app limiter with a shared one.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_PER_IP=300
RATE_LIMIT_PER_USER=600

# Login brute-force lockout (per IP + email). Tighter than the global limiter.
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCKOUT_WINDOW_MS=900000

# Upper bound on every outbound AI/sidecar HTTP call so a hung provider can't
# stall auto-reply indefinitely.
# >>> ANGGA — 2026-08-11: DINAIKKAN 30000 → 60000. Angkanya dari pengukuran,
# bukan perasaan: median satu giliran 13,5-38,4 detik lewat 2-4 panggilan
# provider, dan satu panggilan berplafon besar sendirian menembus 30 detik —
# itu yang memulangkan HTTP 500 di 3 dari 5 putaran pengukuran 10 Agu.
# Default di kode sudah 60_000 sejak `selesai-171`, TAPI baris `.env` menimpanya,
# jadi perbaikan itu praktis MATI di mesin yang memakai `.env` lama.
# ⚠️ `.env` sungguhan tidak ter-commit — Bossfren harus mengubahnya SENDIRI di
#    sana; mengganti contoh ini saja tidak berefek apa pun.
AI_TIMEOUT_MS=60000

# ── Database / Queue ───────────────────────────────────────────────────────
# Prisma pool tuning is included in the URL. Adjust connection_limit/pool_timeout
# based on the database plan and API replica count.
DATABASE_URL=postgresql://hermes:hermes@localhost:5432/hermes?schema=public&connection_limit=10&pool_timeout=20
REDIS_URL=redis://localhost:6379

# ── Web ────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL is defined above for both local and deployed web builds.

# ── AI Provider (OpenAI-compatible) ────────────────────────────────────────
# Works with any OpenAI-compatible endpoint. Examples:
#   Nous Portal  https://inference-api.nousresearch.com/v1   (Hermes models)
#   Nous proxy   http://127.0.0.1:8645/v1                     (local subscription proxy)
#   OpenRouter   https://openrouter.ai/api/v1
#   OpenAI       https://api.openai.com/v1
#   Ollama       http://localhost:11434/v1
#   LM Studio    http://localhost:1234/v1
#   vLLM         http://localhost:8000/v1
# The app lists available models from {AI_BASE_URL}/models.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
# ⚠️ NILAI DI SINI HANYA DIPAKAI SELAMA BELUM ADA BARIS `AppSetting` DI DATABASE.
#    `SettingsService` melakukan shallow merge dengan baris DB MENIMPA env
#    (`settings.service.ts:344`). Begitu halaman Settings pernah di-Save sekali,
#    baris itu ada, dan mengubah AI_MODEL di sini TIDAK BEREFEK APA PUN.
#    Ini disengaja (admin bisa ganti model tanpa redeploy) — yang tidak
#    disengaja adalah ia membayangi env TANPA SATU PUN TANDA.
#    Sudah menggigit DUA KALI: `codBlockedRegionKeywords` (K22) dan AI_MODEL
#    (2026-08-11 — `.env` diubah ke deepseek, bot tetap jalan llama, dan baru
#    ketahuan karena alat ukur mencatat `modelDilayani` per panggilan).
#    → Untuk mengubah model sungguhan: dashboard Settings → AI → Save.
AI_MODEL=gpt-4o-mini

# ── Saklar F4 & lengan pengukuran F6 ───────────────────────────────────────
# >>> ANGGA — 2026-08-11: DIPINDAH KE SINI dari `apps/.env.example`, yang
# ternyata berkas YATIM: `apps/.env` tidak pernah ada dan tidak pernah dimuat
# siapa pun. ConfigModule.forRoot() tanpa `envFilePath` membaca `<cwd>/.env`,
# dan yang sungguhan terpakai adalah `.env` di AKAR repo lewat `env_file:` di
# docker-compose. Jadi selama ini DUA saklar terdokumentasi di tempat yang tidak
# pernah dibaca. Ditemukan ronde penyanggal audit K23.

# F4 Reply Contract (tool `send_reply` + komposisi kalimat funnel oleh sistem).
# MATI bawaan sejak 2026-08-10 sesudah uji lapangan: komposisi menggandakan
# pertanyaan saat model memparafrase, dan `send_reply` cuma dipakai 2 dari 6
# giliran. Dinyalakan lagi HANYA kalau korpus F6 membuktikan ia menambah nilai.
REPLY_CONTRACT_ENABLED=false

# ── Lengan pengukuran F6 (ketok Bossfren 2026-08-11) ───────────────────────
# LENGAN 1 — validasi ALAT. Gerbang F6 ("3x berulang, sebaran < 5 poin") adalah
#   gerbang kesahihan ALAT UKUR, bukan gerbang mutu bot. Di temperature 0, sisa
#   sebaran apa pun mustahil berasal dari sampling model — jadi ia pasti cacat
#   alat. Jalankan proses API dengan:
#       EVAL_LOCK_PROVIDER=true  EVAL_TEMPERATURE=0  (EVAL_SEED=42 kalau didukung)
# LENGAN 2 — vonis BOT:
#       EVAL_LOCK_PROVIDER=true   EVAL_TEMPERATURE=   EVAL_SEED=      (dua terakhir KOSONG)
#   Temperature produksi yang dipakai, karena kelas bug yang membunuh F4 (model
#   memparafrase kalimat funnel → pertanyaan dobel terkirim) adalah fenomena
#   SAMPLING; di temperature 0 ia sebagian besar lenyap, jadi memvonis F4 di
#   lengan 1 akan salah.
#   ⚠️ KUNCI RUTE TETAP MENYALA di lengan 2. Versi pertama dokumen ini menulis
#      "biarkan ketiganya kosong" dan itu SALAH — ditemukan audit K23: rute
#      penyedia adalah urusan ROUTING, ortogonal terhadap sampling, dan dengan
#      `EVAL_LOCK_PROVIDER` mati `kesahihan.mjs` SELALU memvonis lengan 2
#      "TIDAK SAH". Lengan yang seluruh keputusan F4 bergantung padanya tidak
#      akan pernah bisa lulus, dan operator belajar mengabaikan vonis ⛔.
#   ⚠️ Daftar per-kasus `--bandingkan` di lengan ini DIDOMINASI KEBISINGAN:
#      pada p(gagal)~0,3 dengan 3 putaran, ~64% kasus yang TIDAK berubah tetap
#      muncul sebagai "berubah", arahnya 50:50 acak. Alat mencetak peringatan
#      ini sendiri; jangan baca satu baris sebagai bukti.
#
# ⚠️ PROSES API itu juga melayani admin & job BullMQ. `EVAL_TEMPERATURE` sengaja
#    dibuat DEFAULT (bukan penimpa) supaya pemanggil yang menyebut
#    temperature-nya sendiri — `minePersona` 0.2, `minePlaybook` 0.1 — tidak
#    ikut tersapu dan tidak menulis baris `learningProposal` pada temperature
#    yang bukan rancangannya. Tetap saja: hindari mining saat sesi ukur jalan.
# ⚠️ KETIGANYA dibaca oleh PROSES API, bukan oleh `tools/eval/replay.mjs`
#    (itu cuma klien HTTP). Menyetelnya di shell tempat replay dijalankan TIDAK
#    ADA EFEKNYA. `replay.mjs --bandingkan` menolak menyandingkan dua berkas
#    hasil yang lahir dari lengan berbeda.
# ⚠️ EVAL_LOCK_PROVIDER hanya untuk sesi pengukuran: rute terkunci berarti
#    penyedia hulu tumbang = panggilan GAGAL KERAS, tanpa degradasi ke cadangan.
# ⚠️ BELUM TERVERIFIKASI apakah `allow_fallbacks:false` benar-benar mem-pin rute
#    tanpa `provider.order`/`provider.only`. Jangan perlakukan sebagai jaminan.
# ⚠️ EVAL_LOCK_PROVIDER SENDIRIAN TIDAK MENGUNCI RUTE. Diverifikasi ke
#    dokumentasi OpenRouter 2026-08-11: `allow_fallbacks:false` hanya mematikan
#    CADANGAN sesudah pilihan default dibuat — dan pilihan default itu tetap
#    ditentukan routing OpenRouter tiap permintaan. Yang mengunci adalah
#    EVAL_PROVIDER_ONLY di bawah. `kesahihan.mjs` akan memvonis TIDAK SAH kalau
#    kunci diminta tanpa pin, supaya kekeliruan ini tidak terulang diam-diam.
EVAL_LOCK_PROVIDER=false

# Pin penyedia hulu — INI yang benar-benar mengunci rute.
# ISI SATU SLUG SAJA. Boleh dipisah koma secara teknis, TAPI kalau lebih dari
# satu penyedia benar-benar melayani, `kesahihan.mjs` tetap memvonis TIDAK SAH
# ("N penyedia hulu BERBEDA") — dan itu BENAR, karena dua penyedia dalam satu
# pengukuran persis confound yang seluruh pekerjaan ini berantas. Jadi daftar
# lebih dari satu hanya berguna sebagai cadangan ketersediaan, bukan sebagai
# konfigurasi ukur yang bisa lulus.
# Menyalakannya otomatis ikut mematikan fallback; tidak perlu EVAL_LOCK_PROVIDER.
#
# Terukur 2026-08-11, satu percakapan 6 giliran / 20 panggilan:
#   DeepInfra 4 · StreamLake 3 · Parasail 1 · Google 1 · Crusoe 1
# — dan berpindah DI DALAM satu giliran (giliran 3 dilayani tiga penyedia).
# Itulah confound yang membuat biner yang sama memberi `kosong` 25%/0%/0%/0%.
#
# ⚠️ NAMA DI ATAS ADALAH NAMA TAMPILAN, BUKAN SLUG. Diverifikasi 2026-08-11 ke
#    `GET https://openrouter.ai/api/v1/providers` (publik, tanpa auth): `name`
#    dan `slug` adalah KOLOM TERPISAH, 101 penyedia, dan kelima nama di atas ada
#    sebagai `name` — NOL sebagai `slug`. Contoh yang menentukan: `Google`
#    slug-nya `google-vertex`. Ambil slug-nya dari endpoint itu, jangan menebak
#    dari nama, dan JANGAN mengandalkan huruf-kecil sebagai padanan (23 dari 101
#    tidak cocok dengan cara itu).
# ⚠️ Alat SENGAJA TIDAK membandingkan pin dengan penyedia yang melayani — dua
#    ruang nama berbeda, dan perbandingannya akan anti-korelasi dengan kebenaran
#    (lulus saat pin salah, gagal saat pin benar). Yang dibuktikan alat adalah
#    "tepat SATU penyedia melayani seluruh putaran"; keduanya dicetak
#    berdampingan tanpa klaim kecocokan.
EVAL_PROVIDER_ONLY=

EVAL_TEMPERATURE=
EVAL_SEED=

# Recommended Hermes model via Nous Portal:
# AI_BASE_URL=https://inference-api.nousresearch.com/v1
# AI_MODEL=Hermes-4-70B

# Hermes supervisor model (review/ask/insight). Empty = reuse AI_MODEL.
# Set a stronger model than the CS bot for better judgement.
# HERMES_MODEL=Hermes-4-405B

# ── Semantic knowledge retrieval / RAG (optional) ──────────────────────────
# When AI_EMBED_MODEL is set, knowledge items are embedded (via {AI_BASE_URL}
# /embeddings) and retrieved by meaning, not just keywords. Empty = keyword
# retrieval (no behaviour change). Requires the pgvector extension — applied by
# migration 20_knowledge_embeddings. After enabling on an existing DB, run
# `npm run kb:reindex` to backfill embeddings for existing items.
# AI_EMBED_MODEL=text-embedding-3-small
# AI_EMBED_DIM must match the vector(N) column in the migration (default 1536).
AI_EMBED_DIM=1536

# ── Campaign limits (WhatsApp ban mitigation, M8) ──────────────────────────
# Max recipients a single campaign may target.
CAMPAIGN_MAX_RECIPIENTS=1000
# Max campaign messages actually sent per WhatsApp account per 24h, across
# all campaigns. Keep this conservative — high outbound volume risks a ban.
CAMPAIGN_MAX_DAILY_SENDS=500

# ── SLA monitor (stale-chat alerts) ────────────────────────────────────────
# A chat whose last message is from the customer and has gone unanswered
# longer than this is flagged (badge in the UI + outbound notification).
SLA_RESPONSE_MINUTES=15
# Conversations with no customer reply for this many days are auto-resolved.
IDLE_CLOSE_DAYS=3
# How often the SLA scanner runs (milliseconds).
SLA_SCAN_INTERVAL_MS=60000

# ── Auto-assignment ────────────────────────────────────────────────────────
# How new (and unassigned) conversations are routed to admins:
#   off          — no auto-assignment (default; keep manual)
#   round_robin  — rotate through active admins
#   least_busy   — admin with the fewest open conversations
AUTO_ASSIGN_STRATEGY=off

# ── Auto-away (business hours) ─────────────────────────────────────────────
# Min gap between auto-away messages to the same customer (ms, default 12h).
# Business hours + the away message itself are configured per account in the UI.
AUTO_AWAY_COOLDOWN_MS=43200000

# ── CSAT (customer satisfaction) ───────────────────────────────────────────
# When a chat is resolved, ask the customer to rate 1–5; their next numeric
# reply within the window is captured as the score.
CSAT_ENABLED=false
CSAT_WINDOW_HOURS=24
# Optional override for the request message (a sensible Indonesian default is built in).
# CSAT_MESSAGE=

# ── WhatsApp Gateway (Baileys) ─────────────────────────────────────────────
# Must be persistent storage in production; losing it forces QR re-login.
WA_SESSION_DIR=.wa-sessions
# Keep true so chats/messages sent from the linked phone are mirrored into the dashboard.
# Set false only if first-link history backfill is too heavy for your account.
WA_SYNC_FULL_HISTORY=true

# Inbound media (images/documents/audio/video from customers) is downloaded
# and served at /api/v1/media/<file>.
# Max bytes per inbound media file; larger payloads are skipped (default 25MB).
WA_MEDIA_MAX_BYTES=26214400

# Media storage driver: "local" (default) or "s3".
#   local → files under WA_MEDIA_DIR (use persistent storage; single box only)
#   s3    → S3-compatible bucket, including Supabase Storage (multi-replica safe)
MEDIA_STORAGE_DRIVER=local
WA_MEDIA_DIR=.wa-media
# Required when MEDIA_STORAGE_DRIVER=s3:
# MEDIA_S3_BUCKET=hermes-media
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=
# MEDIA_S3_REGION=us-east-1
# For Supabase/MinIO set the S3 endpoint (enables path-style addressing):
# MEDIA_S3_ENDPOINT=https://<project>.supabase.co/storage/v1/s3
# Optional key prefix inside the bucket:
# MEDIA_S3_PREFIX=chat
# Serve straight from a public/CDN bucket instead of proxying through the API:
# MEDIA_S3_PUBLIC_BASE_URL=https://<project>.supabase.co/storage/v1/object/public/hermes-media

# ── WhatsApp Gateway (Baileys, in-process) ───────────────────────────────────
# Baileys runs inside the API process — no sidecar container. Session auth state
# is persisted to WA_SESSION_DIR (set above); back that path up to avoid having
# to re-scan QR codes after a redeploy.
# WA_SYNC_FULL_HISTORY=false   # set to skip full history sync on first connect
# WA_MEDIA_MAX_BYTES=26214400  # max inbound media size to download (bytes)

# WhatsApp session tuning
WA_KEEPALIVE_MS=30000       # WebSocket keepalive interval (ms)
WA_MARK_ONLINE=false        # Mark account as online when connecting (not used — markOnlineOnConnect is hardcoded false)
# WA_BROWSER_PLATFORM=Mac OS  # Baileys browser-id 1st field (platform/OS).
# WA_BROWSER_NAME=Safari      # 2nd field (app name).
# WA_BROWSER_VERSION=17.4.1   # 3rd field (version). Rotate these if WhatsApp
                              # starts rejecting registration/pairing for
                              # Baileys' literal default signature
                              # ('Mac OS','Desktop','14.4.1') or for a
                              # specific platform combo post-scan — see
                              # WhiskeySockets/Baileys issues #2370 / #2381 / #2658.

# ── Notifications (via Hermes Agent gateway) ───────────────────────────────
# Outbound alerts are delivered through the Hermes Agent CLI:
#   hermes send --to <target>
# Configure platform credentials inside Hermes Agent (`hermes gateway setup`).
# Leave HERMES_NOTIFY_TARGET empty/commented to disable outbound alerts.
# HERMES_NOTIFY_TARGET=telegram
HERMES_BIN=hermes

# ── Hermes Agent sidecar (optional, agentic supervision) ───────────────────
# Python sidecar wrapping hermes-agent's AIAgent (services/hermes-sidecar).
# Bind the sidecar to 127.0.0.1 and set a shared token — /ask is an agent
# endpoint and must never be exposed unauthenticated.
# HERMES_SIDECAR_URL=http://127.0.0.1:8675
# HERMES_SIDECAR_TOKEN=generate-with-openssl-rand-hex-32
# HERMES_AGENT_MODEL=Hermes-4-70B
# HERMES_AGENT_MEMORY=true

# ── Agent CRM report API (inbound, read-only supervisor) ───────────────────
# Lets the Hermes Agent gateway PULL read-only CRM reports from this app via
#   GET /api/v1/agent/crm-report   (header: x-api-key: <AGENT_API_KEY>)
# This is supervisor-scoped: read-only reports only — no mutations, no message
# sends, no user/settings access. Leave empty to disable the endpoint (it then
# returns 503). Generate with: openssl rand -hex 32
# AGENT_API_KEY=

# ── Observability / monitoring ─────────────────────────────────────────────
# Structured JSON logs are emitted by default. LOG_LEVEL sets the minimum level
# (verbose|debug|log|warn|error). LOG_PRETTY=true switches to human-readable
# colored output for local dev.
# LOG_LEVEL=log
# LOG_PRETTY=false
# Prometheus scrape endpoint is GET /api/v1/metrics. If METRICS_TOKEN is set the
# scraper must send it as a Bearer token; if unset, expose /metrics on an
# internal network only. Generate with: openssl rand -hex 32
# METRICS_TOKEN=
# Optional error webhook (Sentry-store / Slack incoming / any JSON sink). When
# set, server errors and unhandled rejections are POSTed here (no PII). Unset =
# log-only (structured error lines are always written regardless).
# ERROR_WEBHOOK_URL=
# Shared secret for POST /api/v1/internal/alerts (Alertmanager webhook
# receiver). Alertmanager sends it as `Authorization: Bearer <token>`; the
# endpoint forwards firing/resolved alerts through the existing
# HERMES_NOTIFY_TARGET channel. Leave empty to disable (returns 503).
# Generate with: openssl rand -hex 32
# ALERTMANAGER_WEBHOOK_TOKEN=

# ── Seed (initial owner account) ───────────────────────────────────────────
SEED_OWNER_EMAIL=owner@hermes.local
SEED_OWNER_PASSWORD=changeme123

# --- Shipping Service Mengantar (modul ongkir live) ---
# Kredensial toko. Kosong = modul ongkir mati total dan bot selalu menjawab
# "ongkir belum bisa dipastikan" (tidak pernah menebak angka).
MENGANTAR_API_KEY=
MENGANTAR_ORIGIN_ID=
MENGANTAR_BASE_URL=https://app.mengantar.com
# Fallback berat per produk (gram) kalau Product.weightGrams kosong.
SHIPPING_DEFAULT_WEIGHT_GRAMS=1000
# Opsional, semua sudah punya default sesuai kebijakan toko:
# SHIPPING_COURIER_EXCLUDE=paxel,JNECargo,SiCepatCargo,SapCargo,iDexpressCargo,SAPLite,iDlite
# SHIPPING_COD_ALLOWLIST=JNE
# SHIPPING_COD_BLOCKED_REGION_KEYWORDS=papua,maluku
# SHIPPING_QUOTE_CACHE_TTL_MS=21600000
# SHIPPING_DISCOUNT_MAX_PER_ORDER=5000
# SHIPPING_PRICE_ROUNDING_INCREMENT=500
# >>> ANGGA: kamus nama panggilan daerah -> nama yang dikenal Mengantar.
# Format "dari=ke", dipisah koma. Kosong/tidak diset = pakai daftar bawaan di
# settings.service.ts, dan bisa diubah kapan saja dari /settings/shipping.
# SHIPPING_DESTINATION_ALIASES=solo=surakarta,jogja=yogyakarta,sby=surabaya,malang=klojen

# >>> ANGGA — Order Context Log (memori order percakapan, blueprint 2026-08-04).
# Semua opsional; default sesuai ketok Bossfren dan bisa diubah dari
# /settings/shipping tanpa deploy.
# ORDER_CONTEXT_STALE_HOURS=24
# ORDER_CANCEL_KEYWORDS=batal,gak jadi,ga jadi,nggak jadi,tidak jadi,cancel
# ORDER_AGGREGATE_KEYWORDS=semuanya,semua,seluruhnya,sekaligus,digabung,gabung,totalin semua,dua-duanya,tiga-tiganya,borong,sama yang tadi
# ORDER_AFFIRMATION_KEYWORDS=iya,iyaa,ya,yup,betul,bener,benar,itu,oke,ok,sip,gas,boleh,mau,jadi,lanjut
# ORDER_NEGATION_KEYWORDS=gak,ga,nggak,ngga,bukan,jangan,tidak,no
# ORDER_FILLER_WORDS=kak,ka,dong,deh,aja,sih,min,gan,bang,mas,mbak,pak,bu,nya,yg,yang,yaudah,udah
# Teks catatan S&K COD + pemesanan (nilai penanda global {{catatan_sk}}).
# Kosong = penanda tidak tersedia & deteksi selesai-order otomatis mati.
# ORDER_CLOSING_NOTE=
# prompt_only | retry_once (default)
# ORDER_BRIDGE_ENFORCEMENT=retry_once
# >>> Addendum v2 (2026-08-05) — kategori AppSetting `orderContext`, halaman
# /settings/order-memory. Semua opsional:
# ORDER_DEIXIS_KEYWORDS=yg ini,yang ini,yg itu,yang itu,ini aja,itu aja
# ORDER_OFFER_WINDOW_MINUTES=60
# Kamus token global, format "nama_token=isi" dipisah koma (isi tanpa koma) —
# lebih enak diisi dari dashboard: ORDER_GLOBAL_TOKENS=
# ORDER_FORM_HINT_KEYWORDS=form pemesanan,sudah melakukan pemesanan,mengisi form
# ORDER_REFERENCE_KEYWORDS=yang tadi,yg tadi,pesanan tadi,order tadi,yang kemarin,sebelumnya
# ORDER_NEGO_KEYWORDS=diskon lagi,kurangin,murahin,free ongkir,gratis ongkir,nego
